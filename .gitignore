# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# .terraformrc and terraform.rc
.terraformrc
terraform.rc

# Plan files
*.tfplan

# Sensitive variable files (optional, depending on your setup)
*.tfvars
*.tfvars.json

# Override files (used locally, not meant to be pushed)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Backup files
*.backup

# IDE/editor junk
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
